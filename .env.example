# Starvia environment template
# Copy this file to .env.local for local development.
# NEVER commit real secrets to GitHub.
#
# PUBLIC = safe for browser bundles.
# SERVER = keep private; Vercel Production/Preview environment variables should
# contain the real values.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://zwrtvfahcgvssbndvray.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback — optional while migrating to publishable/secret keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose this in NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Legacy fallback — optional.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Gemini / AI
# ─────────────────────────────────────────────────────────────────────────────
# SERVER ONLY.
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
AI_TUTOR_SYSTEM_PROMPT=
AI_TIMEOUT_MS=45000

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — prepared, not required until payments are enabled
# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC Key ID is safe to expose to the Razorpay checkout client.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SERVER ONLY.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ULTRA=

# ─────────────────────────────────────────────────────────────────────────────
# Application / branding
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_BRAND_MARK=
NEXT_PUBLIC_BRAND_LOGO=

# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=

# Development/testing controls
# Keep mock checkout OFF in production.
ALLOW_MOCK_CHECKOUT=false
# Used for authenticated scheduled/server jobs if enabled.
CRON_SECRET=

# Authentication is Google OAuth only.
# Configure Google under Supabase Authentication → Providers → Google.
# Email/password UI and password reset are intentionally not part of Starvia.
