###############################################################################
# Starvia — environment variables
#
# Copy this file to `.env.local` for local development, and paste the same keys
# into Vercel → Project → Settings → Environment Variables for production.
#
# Nothing here is required to *run* the app: without keys Starvia starts in a
# safe, clearly-labelled demo mode. Each integration switches on the moment its
# keys are present. Never commit real keys.
###############################################################################

# ------------------------------------------------------------------ Supabase -
# Required for real accounts, saved data, RLS and file storage.
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for trusted writes (usage counters, payments, admin stats).
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------- Gemini -
# Required for real AI responses. Get a key at https://aistudio.google.com/apikey
# All Gemini calls happen on the server only.
GEMINI_API_KEY=
# Optional model overrides (defaults shown). Use models available to your key.
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
# Optional: override the tutor's system prompt without a redeploy.
AI_TUTOR_SYSTEM_PROMPT=
# Optional: request timeout budget in milliseconds (default 45000).
AI_TIMEOUT_MS=45000

# ------------------------------------------------------------------- Razorpay -
# Required to accept real payments. Razorpay dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only. Used to verify payment signatures.
RAZORPAY_KEY_SECRET=
# Server-only. Razorpay dashboard → Webhooks → secret. Point the webhook at
# https://your-domain.com/api/webhooks/razorpay and subscribe to subscription.*
# and payment.captured / payment.failed.
RAZORPAY_WEBHOOK_SECRET=
# Optional recurring plan ids (Subscriptions → Plans). Without them, checkout
# falls back to a one-time order and the plan is activated for 30 days.
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ULTRA=

# ----------------------------------------------------------------------- App -
# Used for canonical URLs, Open Graph tags and auth redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=
# Shows the Google button on login/signup. Enable the Google provider in
# Supabase → Authentication → Providers first.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
# Optional: point the header/footer logo at your own hosted assets.
NEXT_PUBLIC_BRAND_MARK=
NEXT_PUBLIC_BRAND_LOGO=

# ------------------------------------------------------------------ Dev only -
# Forces demo mode (seeded data, placeholder AI replies). Never enable this on a
# production deployment.
NEXT_PUBLIC_DEMO_MODE=false
# Allows the clearly-labelled "test activation" checkout when Razorpay is not
# configured. Ignored — and always hard-disabled — in production builds.
ALLOW_MOCK_CHECKOUT=false
# Optional secret for scheduled jobs that call /api endpoints (e.g. Vercel Cron).
CRON_SECRET=
